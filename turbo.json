{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {},
    "package": {
      "dependsOn": ["build"]
    },
    "install-app": {
      "dependsOn": ["build"],
      "cache": false
    },
    "snapshots": {
      "cache": false
    },
    "icon": {
      "cache": false
    }
  }
}
